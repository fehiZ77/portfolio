---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/sections/Hero.astro';
import Work from '../components/sections/Work.astro';
import HowIWork from '../components/sections/HowIWork.astro';
import Stack from '../components/sections/Stack.astro';
import Background from '../components/sections/Background.astro';
import Contact from '../components/sections/Contact.astro';
import { basic } from '../config/cv.json';
---

<Layout
	title={`${basic.name} — ${basic.role}`}
	description="Backend-leaning full-stack developer in Mauritius. Sole developer of the JKA Mauritius management platform: six modules in production on FTP-only hosting, with CI, test coverage and incident response."
>
	<Hero />
	<Work />
	<HowIWork />
	<Stack />
	<Background />
	<Contact />
</Layout>
