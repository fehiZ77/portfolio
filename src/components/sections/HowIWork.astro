---
import SectionHeading from "../common/SectionHeading.astro";
import { howIWork } from "../../config/cv.json";
---

<section id="approach" class="border-b border-hair">
  <div class="mx-auto max-w-page px-5 py-14 sm:py-16">
    <SectionHeading eyebrow="Fig. 02 — Approach" title="Constraint-first engineering" />

    <div class="max-w-[68ch] space-y-4 text-[15px] text-muted sm:text-base">
      {howIWork.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </div>
</section>
