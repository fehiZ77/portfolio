---
import { basic } from "../../config/cv.json";
---

<section id="contact">
  <div class="mx-auto max-w-page px-5 py-14 sm:py-16">
    <div class="rounded border border-strong bg-navy p-7 text-on-navy sm:p-9">
      <p class="font-mono text-xs uppercase tracking-[0.14em] text-on-navy/70">
        Fig. 05 — Contact
      </p>

      <h2 class="mt-3 text-balance text-2xl font-bold sm:text-3xl">
        Let's talk about your project.
      </h2>

      <p class="mt-3 max-w-[55ch] text-on-navy/80">
        {basic.availability} Based in {basic.location}, comfortable working remotely across
        time zones.
      </p>

      <div class="mt-7 flex flex-wrap gap-3">
        <a
          href={`mailto:${basic.email}`}
          class="inline-flex min-h-[44px] items-center rounded border border-on-navy/40 px-4 py-3
            font-mono text-sm transition-colors duration-150 hover:bg-on-navy/10"
        >
          {basic.email}
        </a>
        <a
          href={basic.github}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-[44px] items-center rounded border border-on-navy/40 px-4 py-3
            font-mono text-sm transition-colors duration-150 hover:bg-on-navy/10"
        >
          GitHub ↗
        </a>
        <a
          href={basic.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-[44px] items-center rounded border border-on-navy/40 px-4 py-3
            font-mono text-sm transition-colors duration-150 hover:bg-on-navy/10"
        >
          LinkedIn ↗
        </a>
      </div>
    </div>
  </div>
</section>
