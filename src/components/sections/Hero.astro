---
import { Image } from 'astro:assets';
import heroImage from '../../assets/fehizoro-rajonhson.jpg';
import { basic } from '../../config/cv.json';
---

<section class="border-b border-hair">
  <div class="mx-auto max-w-page px-5 py-14 sm:py-20">
    <div class="grid grid-cols-1 items-center gap-10 md:grid-cols-[1fr_auto] md:gap-14">
      <div>
        <p class="font-mono text-xs uppercase tracking-[0.14em] text-accent-text">
          {basic.role} · {basic.location}
        </p>

        <h1 class="mt-4 text-balance text-3xl font-bold leading-tight sm:text-4xl lg:text-[2.75rem]">
          {basic.headline}
        </h1>

        <p class="mt-5 max-w-[58ch] text-base text-muted sm:text-lg">
          {basic.intro}
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href={`/cv/${basic.cv_file_name}`}
            download
            class="inline-flex min-h-[44px] items-center rounded border border-navy bg-navy px-5
              py-3 font-mono text-sm text-on-navy transition-colors duration-150 hover:opacity-90"
          >
            Download CV
          </a>
          <a
            href="#contact"
            class="inline-flex min-h-[44px] items-center rounded border border-strong px-5 py-3
              font-mono text-sm transition-colors duration-150 hover:border-accent hover:text-accent-text"
          >
            Get in touch
          </a>
        </div>
      </div>

      <div class="order-first md:order-last">
        <Image
          class="w-36 rounded border border-hair sm:w-44 md:w-56"
          src={heroImage}
          widths={[144, 224, 448]}
          sizes="(min-width: 768px) 224px, 176px"
          loading="eager"
          alt={`Portrait of ${basic.name}`}
        />
      </div>
    </div>
  </div>
</section>
