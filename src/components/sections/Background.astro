---
import SectionHeading from "../common/SectionHeading.astro";
import { experience, education, languages } from "../../config/cv.json";
---

<section id="background" class="border-b border-hair">
  <div class="mx-auto max-w-page px-5 py-14 sm:py-16">
    <SectionHeading eyebrow="Fig. 04 — Background" title="Experience & education" />

    <div class="grid grid-cols-1 gap-10 lg:grid-cols-2">
      <div>
        <h3 class="font-mono text-xs uppercase tracking-wider text-muted">Experience</h3>
        <ul class="mt-4 space-y-5">
          {experience.map((item) => (
            <li class="border-b border-hair pb-5 last:border-b-0 last:pb-0">
              <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                <p class="font-semibold">{item.title}</p>
                <p class="whitespace-nowrap font-mono text-xs text-muted">{item.years}</p>
              </div>
              <p class="mt-1 text-sm text-muted">{item.sub_title}</p>
              <p class="mt-2 text-sm">{item.details}</p>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="font-mono text-xs uppercase tracking-wider text-muted">Education</h3>
        <ul class="mt-4 space-y-5">
          {education.map((item) => (
            <li class="border-b border-hair pb-5 last:border-b-0 last:pb-0">
              <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                <p class="font-semibold">{item.title}</p>
                <p class="whitespace-nowrap font-mono text-xs text-muted">{item.years}</p>
              </div>
              <p class="mt-1 text-sm text-muted">{item.sub_title}</p>
            </li>
          ))}
        </ul>

        <h3 class="mt-8 font-mono text-xs uppercase tracking-wider text-muted">Languages</h3>
        <ul class="mt-4 space-y-2">
          {languages.map((item) => (
            <li class="flex flex-wrap items-baseline justify-between gap-x-4 text-sm">
              <span class="font-semibold">{item.label}</span>
              <span class="text-muted">{item.value}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
