---
import { Icon } from "astro-icon/components";
import { basic, socialLinks } from "../../config/cv.json";

const year = new Date().getFullYear();
---

<footer class="border-t border-hair">
  <div
    class="mx-auto flex max-w-page flex-col items-center justify-between gap-5 px-5 py-8
      sm:flex-row"
  >
    <p class="font-mono text-xs text-muted">
      © {year} {basic.name} · {basic.location}
    </p>

    <ul class="flex items-center gap-2">
      {socialLinks.map((social) => (
        <li>
          <a
            href={social.link}
            target="_blank"
            rel="noopener noreferrer"
            class="flex min-h-[44px] min-w-[44px] items-center justify-center rounded text-muted
              transition-colors duration-150 hover:text-ink"
          >
            <Icon name={social.iconName} class="size-5" />
            <span class="sr-only">{social.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</footer>
